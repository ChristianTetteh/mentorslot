DATABASE_URL=postgres://user:password@localhost:5432/mentorslot
PORT=4001
# Single frontend origin, no trailing slash. Warns at boot in production if unset.
CORS_ORIGIN=http://localhost:5173
# Set to "false" only for local Postgres without SSL
PGSSL=true

# --- Private manage links ---------------------------------------------------
# REQUIRED in production (the server refuses to boot without it): a random
# secret of at least 32 characters, e.g.  openssl rand -base64 48
# It is the HMAC key behind every manage link. Keep it secret; changing it
# invalidates all existing links. Outside production a fixed dev value is used.
MANAGE_SECRET=
# Where links in emails point (the deployed frontend, no trailing slash).
# Falls back to the first value of CORS_ORIGIN. Never taken from request headers.
FRONTEND_ORIGIN=http://localhost:5173

# --- Email (Brevo REST API) -------------------------------------------------
# Leave BREVO_API_KEY empty to run without email: outside production the
# message (with its link) is printed to the server console instead, and
# "Email me my links" answers 503. MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=MentorSlot
